<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>PowderMeet</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Ski Activity</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.topografix.gpx</string>
				<string>com.garmin.tcx</string>
				<string>com.garmin.fit</string>
				<string>com.consumedbycode.slopes</string>
				<string>com.corecoders.skitracks.skiz</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PowderMeet Backup</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.powdermeet.backup</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.powdermeet.PowderMeet.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>powdermeet</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>MBXAccessToken</key>
	<string>$(MAPBOX_ACCESS_TOKEN)</string>
	<key>NSCameraUsageDescription</key>
	<string>PowderMeet uses the camera to take your profile photo.</string>
	<key>NSContactsUsageDescription</key>
	<string>PowderMeet checks your contacts' email addresses to suggest friends already on the app. Only scrambled (hashed) email addresses are sent to find them; names and numbers stay on your phone.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>PowderMeet reads your downhill skiing and snowboarding workouts and their routes from Apple Health to add those runs to your history and learn your pace.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>PowderMeet does not write to Apple Health. It only reads ski and snowboard workouts you choose to import.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>During a meet, and while live run recording is on, PowderMeet keeps using your location with your phone locked so your friend can still find you and your runs are recorded, and notices when you arrive at a resort to start recording. Away from resorts it does not track you.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>PowderMeet uses your location to show where you are on the mountain, share your position with friends you choose, and find the best meeting spot. At a resort it keeps sharing with your phone locked, shown by the blue location indicator.</string>
	<key>SupabasePublishableKey</key>
	<string>$(SUPABASE_PUBLISHABLE_KEY)</string>
	<key>SupabaseURL</key>
	<string>$(SUPABASE_URL)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>PowderMeet Backup</string>
			<key>UTTypeIdentifier</key>
			<string>com.powdermeet.backup</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>powdermeet</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.powdermeet.backup+json</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.xml</string>
			</array>
			<key>UTTypeDescription</key>
			<string>GPS Exchange Format</string>
			<key>UTTypeIdentifier</key>
			<string>com.topografix.gpx</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>gpx</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/gpx+xml</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.xml</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Training Center XML</string>
			<key>UTTypeIdentifier</key>
			<string>com.garmin.tcx</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>tcx</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.garmin.tcx+xml</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>FIT Activity</string>
			<key>UTTypeIdentifier</key>
			<string>com.garmin.fit</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>fit</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Slopes Recording</string>
			<key>UTTypeIdentifier</key>
			<string>com.consumedbycode.slopes</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>slopes</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Ski Tracks Recording</string>
			<key>UTTypeIdentifier</key>
			<string>com.corecoders.skitracks.skiz</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>skiz</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
